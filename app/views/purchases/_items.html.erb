<%# locals: (purchase:) %>
<% currency = purchase.currency.presence || Current.family.currency %>
<ul class="divide-y divide-subdued">
  <% purchase.items.includes(:category).each do |item| %>
    <li class="flex items-center justify-between gap-3 py-2 text-sm">
      <span class="min-w-0">
        <span class="block text-primary truncate"><%= item.name %></span>
        <span class="block text-xs text-secondary">
          <% if item.quantity && item.quantity != 1 %><%= t("purchases.quantity", count: item.quantity.to_s("F").sub(/\.0\z/, "")) %> &middot; <% end %>
          <%= item.category&.name || t("purchases.uncategorized") %>
          <% if item.seller.present? %>&middot; <%= t("purchases.sold_by", seller: item.seller) %><% end %>
        </span>
      </span>
      <span class="text-primary privacy-sensitive shrink-0"><%= item.amount ? format_money(Money.new(item.amount, currency)) : "—" %></span>
    </li>
  <% end %>
</ul>
