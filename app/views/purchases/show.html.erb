<%= content_for :page_title, @purchase.merchant.presence || t("purchases.unknown_merchant") %>
<div class="space-y-4 pb-6 lg:pb-12 max-w-3xl">
  <%= render DS::Link.new(text: t(".back"), href: purchases_path, variant: :default, icon: "arrow-left", class: "text-sm") %>

  <div class="bg-container rounded-xl shadow-border-xs p-4 space-y-3">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <h1 class="text-xl font-medium text-primary truncate"><%= @purchase.merchant.presence || t("purchases.unknown_merchant") %></h1>
        <p class="text-sm text-secondary">
          <%= @purchase.ordered_on ? l(@purchase.ordered_on, format: :long) : "—" %>
          <% if @purchase.order_number.present? %>&middot; <%= t(".order_number", number: @purchase.order_number) %><% end %>
        </p>
      </div>
      <div class="text-right shrink-0 space-y-1">
        <p class="text-xl text-primary privacy-sensitive">
          <%= @purchase.total ? format_money(Money.new(@purchase.total, @purchase.currency.presence || Current.family.currency)) : "—" %>
        </p>
        <%= render "purchases/status_badge", purchase: @purchase %>
      </div>
    </div>

    <dl class="grid grid-cols-2 gap-2 text-sm">
      <dt class="text-secondary"><%= t(".source") %></dt>
      <dd class="text-primary"><%= t("purchases.sources.#{@purchase.source}") %></dd>
      <dt class="text-secondary"><%= t(".payment_method") %></dt>
      <dd class="text-primary"><%= t("purchases.payment_methods.#{@purchase.payment_method}") %></dd>
      <% if @purchase.shipping_cost %>
        <dt class="text-secondary"><%= t(".shipping") %></dt>
        <dd class="text-primary privacy-sensitive"><%= format_money(Money.new(@purchase.shipping_cost, @purchase.currency.presence || Current.family.currency)) %></dd>
      <% end %>
    </dl>
  </div>

  <% if @purchase.review_reasons.any? %>
    <%= render DS::Alert.new(variant: :warning, message: @purchase.review_reasons.map { t("purchases.review_reasons.#{_1["reason"]}", default: _1["reason"].to_s.humanize) }.uniq.to_sentence) %>
  <% end %>

  <div class="bg-container rounded-xl shadow-border-xs p-4 space-y-3">
    <h2 class="text-sm font-medium text-primary"><%= t(".payment") %></h2>
    <% if @entry %>
      <div class="flex items-center justify-between gap-3">
        <%= link_to transaction_path(@entry), class: "min-w-0 text-sm", data: { turbo_frame: :drawer } do %>
          <span class="block text-primary truncate"><%= @entry.name %></span>
          <span class="block text-xs text-secondary"><%= l(@entry.date, format: :short_with_year) %> &middot; <%= @entry.account.name %></span>
        <% end %>
        <%= render DS::Button.new(text: t(".unlink"), href: purchase_link_path(@purchase), method: :delete, variant: :outline, size: :sm,
                                  data: { turbo_confirm: t(".unlink_confirm") }) %>
      </div>
    <% elsif @purchase.matched? %>
      <p class="text-sm text-secondary"><%= t(".linked_elsewhere") %></p>
    <% else %>
      <p class="text-sm text-secondary"><%= t(".no_payment.#{@purchase.status}", default: t(".no_payment.default")) %></p>
      <div class="flex flex-wrap gap-2">
        <% if @purchase.status.in?(Purchase::OPEN_STATUSES) || @purchase.dismissed? %>
          <%= render DS::Link.new(text: t(".link"), href: new_purchase_link_path(@purchase), variant: :primary, size: :sm,
                                  icon: "link", frame: :modal) %>
        <% end %>
        <% if @purchase.status.in?(Purchase::OPEN_STATUSES) %>
          <%= render DS::Button.new(text: t(".dismiss"), href: dismiss_purchase_path(@purchase), method: :post, variant: :outline, size: :sm) %>
        <% end %>
        <% if @purchase.failed? && @purchase.email? %>
          <%= render DS::Button.new(text: t(".reprocess"), href: reprocess_purchase_path(@purchase), method: :post, variant: :outline, size: :sm, icon: "refresh-cw") %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @purchase.items.any? %>
    <div class="bg-container rounded-xl shadow-border-xs p-4 space-y-3">
      <h2 class="text-sm font-medium text-primary"><%= t(".items") %></h2>
      <%= render "purchases/items", purchase: @purchase %>
    </div>
  <% end %>

  <div class="bg-container rounded-xl shadow-border-xs p-4 space-y-3">
    <% if @purchase.email? && @purchase.original_email.attached? %>
      <%= render DS::Link.new(text: t(".download_email"), href: original_email_purchase_path(@purchase), variant: :default, icon: "download", class: "text-sm", data: { turbo: false }) %>
    <% end %>
    <% if @purchase.receipt? && @entry %>
      <%= render DS::Link.new(text: t(".view_receipt"), href: transaction_path(@entry), variant: :default, icon: "receipt", class: "text-sm", data: { turbo_frame: :drawer }) %>
    <% end %>
    <%= render "purchases/ai_metadata", purchase: @purchase %>
  </div>
</div>
